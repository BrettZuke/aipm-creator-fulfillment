# ---------------------------------------------------------------------------
# Free keys. Everything in tools/ runs on these.
# ---------------------------------------------------------------------------

# Gemini: the two agent passes in the content machine (signal parser + scripter).
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq: fallback for the scripter when Gemini is rate limited. Also free Whisper
# for transcribing a client's own reels, which is how the voice document is built.
# Free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Apify: Instagram and TikTok scraping. Free tier per account, roughly $5 of
# credit a month each. Several can be pooled, comma separated, and apify_pool.py
# rotates them so one exhausted token does not stop a run.
APIFY_API_TOKEN=
APIFY_TOKENS=

# Instagram handle used for scraping context (not a login).
INSTAGRAM_USERNAME=

# ---------------------------------------------------------------------------
# THE CLIENT'S OWN INFRASTRUCTURE
#
# Every one of these belongs to the client, never to you and never to another
# client. This is the file you swap when you switch client, and it is the only
# one: nothing is hardcoded in any script. Getting one of these wrong writes
# this client's content onto another client's board, and nothing errors.
# ---------------------------------------------------------------------------

# Their Supabase project, from phase 3.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ACCESS_TOKEN=

# The project ref (the subdomain of the Supabase URL) and the workspace id the
# dashboard created on first run.
SUPABASE_PROJECT_REF=
CONTENT_AGENCY_ID=

# Their dashboard, no trailing slash. The board lives at <this>/content?tab=board
# and the feedback buttons in the morning email post back to it.
CONTENT_APP_URL=

# Who receives the scripts.
CONTENT_EMAIL_TO=

# Must be byte-identical to the same variable in the dashboard's environment.
# The email signs each feedback button with it and the app verifies the
# signature, so a mismatch makes every button in the email fail with a 403.
SECRETS_ENCRYPTION_KEY=

# Resend, for the morning scripts email. Free tier.
RESEND_API_KEY=
RESEND_FROM=

# ---------------------------------------------------------------------------
# Sales calls (only if the client has closers)
# ---------------------------------------------------------------------------

# Your name and email as they appear in Fathom transcripts, so the tool can tell
# the closer from the prospect.
FATHOM_HOST_NAME=
FATHOM_HOST_EMAIL=

# The Google Sheet holding the post-call form responses, and the response tab
# for that form. The service account needs edit access: share the sheet with the
# client_email inside the JSON, the same way you would share with a person.
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=
CLOSER_FORM_TAB=

# Gmail address for the competitor marketing-email reader (IMAP, app password).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ---------------------------------------------------------------------------
# PAID. Leave blank unless you have decided to spend on a specific run.
# ---------------------------------------------------------------------------

# Only content_plan_generator.py and creator_content_engine.py read these.
# Nothing in the daily chain calls a paid API. Setting them does not make
# anything else use them, but leaving them blank guarantees no accidental spend.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
